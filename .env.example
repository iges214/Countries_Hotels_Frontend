# Browser API origin, without /api/v1. Empty uses same-origin reverse proxy.
VITE_API_URL=
# Vite development proxy only. Use the backend's trusted HTTPS URL if it redirects HTTP.
API_PROXY_TARGET=http://localhost:5183
# Demo data is available only in development, using ?demo=1. Never enabled in builds.
# Optional VERIFIED hotel details. Leave empty until supplied by the hotel.
VITE_HOTEL_PHONE=
VITE_HOTEL_EMAIL=
VITE_HOTEL_HERO_IMAGE=
# Optional reviewed policy text, publicly visible. Restart after changes.
VITE_PRIVACY_POLICY=
VITE_BOOKING_POLICY=
